{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/backchannel/src/main.rs",
      "use": "@vercel/rust"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/backchannel/src/main.rs"
    }
  ],
  "regions": [
    "iad1"
  ],
  "git": {
    "deploymentEnabled": {
      "feat/mcp-oauth": false,
      "feat/grumpy-oauth-handoff": false,
      "feat/readonly-viewer": false
    }
  }
}
