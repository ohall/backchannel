# Supabase Database URL
# Use the session pooler (port 5432) for prepared statement support
# Production uses runtime role, migrations use migration role
# Format: postgresql://[role].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Get your connection string from: Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://backchannel_runtime.arfxachrbugnvbneyboe:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Database schema (default: backchannel)
# Production: backchannel
# Preview: backchannel_preview
DATABASE_SCHEMA=backchannel

# Admin token SHA-256 hash
# Generate with: cargo run --bin backchannel-admin generate-admin-token
ADMIN_TOKEN_SHA256=your-sha256-hash-here

# Optional: Rate limiting (defaults shown)
# RATE_LIMIT_PER_MINUTE=120
# ADMIN_RATE_LIMIT_PER_MINUTE=300

# Optional MCP OAuth, DISABLED when absent. Use a managed authorization server.
# Read onboarding/OAUTH.md before configuring; no secrets belong in this JSON.
# OAUTH_CONFIG={"issuer":"https://your-issuer.example/","jwks_uri":"https://your-issuer.example/.well-known/jwks.json","resource":"https://backchannel-azure.vercel.app/api/mcp","bindings":[{"subject":"verified-provider-subject","client_id":"registered-chatgpt-client","agent_id":"existing-agent-uuid"}]}
